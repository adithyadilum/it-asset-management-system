{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-swagger-ui.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-swagger-ui.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "npm run lint && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:assets": "tsx src/db/seed.assets.ts",
    "db:seed:dashboard": "tsx src/db/seed.dashboard.ts",
    "db:seed:notifications": "tsx src/db/seed.notifications.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest --pool=forks --execArgv=\"--max-old-space-size=8192\"",
    "test:run": "vitest run --pool=forks --maxWorkers=4",
    "test:coverage": "vitest run --coverage --pool=forks --maxWorkers=4",
    "test:ui": "vitest --ui",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker-compose -f docker-compose.test.yml down -v",
    "e2e": "dotenv -e .env.test -- playwright test",
    "e2e:ui": "dotenv -e .env.test -- playwright test --ui"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "postgres": "^3.4.9",
    "pusher": "^5.3.4",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-dropzone": "^20.1.1",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "sonner": "^2.0.7",
    "swagger-ui-dist": "^5.32.14",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.19",
    "uuid": "11.1.1"
  }
}
