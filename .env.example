# ==============================================================================
# .env.example
# INSTRUCTIONS: Copy this file, rename it to '.env.local', and fill in the 
# actual values. NEVER commit '.env.local' to version control (GitHub).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless Postgres)
# ------------------------------------------------------------------------------
# Replace this with the unique connection string for your personal Neon branch.
# Make sure it ends with ?sslmode=require
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth.js + Keycloak)
# ------------------------------------------------------------------------------
# The base URL of your application (use localhost for local development).
NEXTAUTH_URL="http://localhost:3000"

# A random string used to hash tokens, sign cookies, and encrypt session data.
# You can generate a secure one in your terminal by running: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_random_32_character_string"
MOBILE_JWT_SECRET="replace_with_a_random_32_character_string_for_mobile_jwt"

# ------------------------------------------------------------------------------
# 3. KEYCLOAK CONFIGURATION
# ------------------------------------------------------------------------------
KEYCLOAK_CLIENT_ID="eitams-web"
KEYCLOAK_CLIENT_SECRET="your_keycloak_client_secret_here"
KEYCLOAK_ISSUER="your_keycloak_issuer_url_here"

# ------------------------------------------------------------------------------
# 4. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode (development, staging, production)
NODE_ENV="development"

JWT_SECRET="your_jwt_secret_key_here"
ENABLE_RUNTIME_LOGS="true"

# ==============================================================================
# 5. NOTIFICATION SYSTEM INFRASTRUCTURE
# ==============================================================================

# ------------------------------------------------------------------------------
# Upstash QStash Configuration (Message Queue & Scheduler)
# Get from: https://console.upstash.com → QStash
# ------------------------------------------------------------------------------
QSTASH_URL="https://qstash-eu-central-1.upstash.io"
QSTASH_TOKEN="your_upstash_qstash_token_here"
QSTASH_CURRENT_SIGNING_KEY="your_qstash_current_signing_key_here"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key_here"

# ------------------------------------------------------------------------------
# Upstash Redis Configuration (Optional Caching)
# Get from: https://console.upstash.com → Redis
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"


# ------------------------------------------------------------------------------
# Encryption Configuration (AES-256-GCM for sensitive data)
# Generate with: openssl rand -base64 32
# Keep this SECRET - never commit it
# ------------------------------------------------------------------------------
ENCRYPTION_SECRET="your_encryption_secret_here"

# ------------------------------------------------------------------------------
# Frontend Configuration (Epic 23 UI Settings)
# Polling interval for real-time notification badge updates (in milliseconds)
# 30000ms = 30 seconds (recommended for production)
# Use 5000ms for faster testing/development
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL="30000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# NOTE ON INTEGRATIONS:
# RESEND_API_KEY and TEAMS_WEBHOOK_URL have been intentionally excluded from 
# this .env file. To prevent configuration drift, these values must be 
# configured via the Admin Settings UI and are stored securely in the database.
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS (Epic 5)
# ------------------------------------------------------------------------------
# Rate limiting configuration (requests per window)
# Set to 'false' once every API key has been used at least once under the
# current hashing scheme (or rotated). Leaving it 'true' keeps pre-existing
# PBKDF2-hashed keys working, at the cost of a slow hash on failed lookups.
API_KEY_LEGACY_HASH_FALLBACK=true

API_RATE_LIMIT_MAX="100"
API_RATE_LIMIT_WINDOW_SECONDS="60"


# Server-only keys (NEVER prefix these with NEXT_PUBLIC)
PUSHER_APP_ID="your_pusher_app_id_here"
PUSHER_SECRET="your_pusher_secret_here"

# Client-safe keys (These must have the NEXT_PUBLIC prefix)
NEXT_PUBLIC_PUSHER_KEY="your_next_public_pusher_key_here"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Vercel blob read and write token
BLOB_READ_WRITE_TOKEN="your_blob_read_write_token_here"
# Token for a separate private Blob store used for invoices, warranties,
# disposal evidence, and other sensitive documents.
PRIVATE_BLOB_READ_WRITE_TOKEN="your_private_blob_read_write_token_here"
