# ==============================================================================
# EITAMS TEST ENVIRONMENT VARIABLES (.env.test.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env.test`
# 2. Do NOT change the TEST_DATABASE_URL (it maps exactly to docker-compose.test.yml)
# 3. Never commit your actual `.env.test` file to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Local Docker Test DB)
# ------------------------------------------------------------------------------
# This must match the credentials in docker-compose.test.yml precisely.
# We use port 54322 to prevent conflicts with your local development database.
TEST_DATABASE_URL="postgresql://test_user:test_password@localhost:54322/eitams_test"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION BYPASS (Playwright Sandbox)
# ------------------------------------------------------------------------------
# Setting this to true activates the /api/test/auth/route.ts endpoint.
# CRITICAL: This must never be true in staging or production!
ENABLE_SANDBOX="true"

# ------------------------------------------------------------------------------
# 3. NEXTAUTH MOCK CONFIGURATION
# ------------------------------------------------------------------------------
# NextAuth requires a URL and a Secret to run locally and encode our test JWTs.
# These can be hardcoded dummy values for the test environment.
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="test-super-secret-key-for-playwright-only"
MOBILE_JWT_SECRET="test-mobile-jwt-secret-for-playwright-only"
ENCRYPTION_SECRET="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_ENABLE_SANDBOX="true"

# ------------------------------------------------------------------------------
# 4. KEYCLOAK MOCK CREDENTIALS
# ------------------------------------------------------------------------------
# For the "One Real Login" test, Playwright might need to reach a Keycloak staging server.
# If your test suite relies 100% on the sandbox bypass, these can remain dummy values.
KEYCLOAK_CLIENT_ID="eitams-test-client"
KEYCLOAK_CLIENT_SECRET="mock-secret-do-not-use-real-one-unless-needed"
KEYCLOAK_ISSUER="https://sso.your-domain.com/realms/eitams-test"
