# ==============================================================================
# .env.example
# INSTRUCTIONS: Copy this file, rename it to '.env.local', and fill in the 
# actual values. NEVER commit '.env.local' to version control (GitHub).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless Postgres)
# ------------------------------------------------------------------------------
# Replace this with the unique connection string for your personal Neon branch.
# Make sure it ends with ?sslmode=require
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[NEON_HOSTNAME]/[DB_NAME]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth.js / Mock Azure AD)
# ------------------------------------------------------------------------------
# The base URL of your application (use localhost for local development).
NEXTAUTH_URL="http://localhost:3000"

# A random string used to hash tokens, sign cookies, and encrypt session data.
# You can generate a secure one in your terminal by running: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_random_32_character_string"

# (Temporary) Mock Provider Keys - Use these if mocking auth via GitHub/Google 
# before receiving the official enterprise Azure AD credentials.
MOCK_AUTH_CLIENT_ID="your_mock_client_id_here"
MOCK_AUTH_CLIENT_SECRET="your_mock_client_secret_here"

# ------------------------------------------------------------------------------
# 3. AZURE AD (Future Production Credentials - LEAVE BLANK FOR NOW)
# ------------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ------------------------------------------------------------------------------
# 4. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode (development, staging, production)
NODE_ENV="development"